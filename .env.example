# Tên TikTok (uniqueId) của kênh đang live, không có dấu @
TIKTOK_USERNAME=

# API key Euler Stream (https://www.eulerstream.com) – gói free bị giới hạn, nên có key khi chạy thật
EULER_API_KEY=

# Cổng server (overlay, control, WebSocket)
PORT=8787

# Nguồn sự kiện khi khởi động: "simulator" (mặc định) hoặc "tiktok"
SOURCE=simulator
